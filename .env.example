# Copy this file to .env and edit the values. The gateway reads .env at startup.
# A variable already set in the shell overrides the value here.

# Address and port. Keep the host on loopback.
GATEWAY_HOST=127.0.0.1
# Port 8000 may be reserved on Windows, so this template uses 8765.
GATEWAY_PORT=8765

# Chat backend. "sydney" talks to the M365 Copilot SignalR API directly
# (recommended: true streaming, no browser at request time).
# "browser" drives the Copilot web UI with Playwright (fallback).
COPILOT_PROVIDER=sydney

# --- Sydney (SignalR) provider settings -------------------------------------

# Microsoft's first-party Office-web Copilot client id, used for the PKCE login.
# You almost certainly do not need to change this.
# M365_CLIENT_ID=c0ab8ce9-e9a0-42e7-b064-33d422df41f1

# Headless alternative to the interactive sign-in: paste a refresh token here
# (it is rotated automatically and saved to TOKEN_PATH). Safer to set in the
# shell than in this file.
# M365_REFRESH_TOKEN=

# Short-lived access token (~1h), useful for testing. No refresh possible.
# M365_ACCESS_TOKEN=

# Seconds to wait for the interactive Microsoft sign-in.
M365_AUTH_TIMEOUT=600
# Default model tone when the requested model id is unknown.
M365_DEFAULT_TONE=magic
# Set to true to disable the server-side Python sandbox (code interpreter).
M365_NO_CODE_INTERPRETER=false
# Where the refresh token is kept (mode 0600). Default: storage/tokens.json.
# TOKEN_PATH=
# Persistent browser profile used only for the one-time sign-in ceremony.
# M365_PROFILE_DIR=

# Text files larger than this many characters are rejected instead of being
# inlined into the prompt.
MAX_INLINE_FILE_CHARS=100000

# --- Browser (Playwright) provider settings ----------------------------------

# Copilot page to drive.
COPILOT_URL=https://copilot.cloud.microsoft/

# false opens a visible browser window, so you can sign in.
HEADLESS=false
# true moves that window off-screen once Copilot is ready. It reappears if sign-in is needed again.
HIDE_WHEN_READY=true

# Browser profile that keeps cookies. Default: playwright-profile/ in the repo root.
# PLAYWRIGHT_PROFILE_DIR=
# Existing Chromium binary to use instead of Playwright's bundled one.
# CHROMIUM_PATH=

# Corporate proxy that asks for a login. Find the address in Windows Settings > Network & Internet
# > Proxy. Leave PROXY_SERVER commented out if the browser reaches Copilot without a proxy.
# PROXY_SERVER=http://proxy.example.com:8080
# PROXY_USERNAME=
# Safer: set the password in the shell rather than storing it in this file.
# PROXY_PASSWORD=

# Timeouts and retries, in seconds.
REQUEST_TIMEOUT=300
MAX_RETRY=3
LOGIN_TIMEOUT=600
# Browser provider only: a reply counts as finished after this long without change.
RESPONSE_STABLE_SECONDS=3

# Browser provider only: messages longer than this many characters are attached
# as a file instead of typed. Typing is slow: a message is typed line by line.
MAX_INLINE_CHARS=2000
# Attachments larger than this many bytes are rejected.
MAX_FILE_BYTES=20971520
