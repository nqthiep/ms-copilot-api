# Copy this file to .env and edit the values. The gateway reads .env at startup.
# A variable already set in the shell overrides the value here.

# Address and port. Keep the host on loopback.
GATEWAY_HOST=127.0.0.1
# Port 8000 may be reserved on Windows, so this template uses 8765.
GATEWAY_PORT=8765

# Copilot page to drive.
COPILOT_URL=https://copilot.cloud.microsoft/

# false opens a visible browser window, so you can sign in.
HEADLESS=false
# true moves that window off-screen once Copilot is ready. It reappears if sign-in is needed again.
HIDE_WHEN_READY=true

# Browser profile that keeps cookies. Default: playwright-profile/ in the repo root.
# PLAYWRIGHT_PROFILE_DIR=
# Existing Chromium binary to use instead of Playwright's bundled one.
# CHROMIUM_PATH=

# Timeouts and retries, in seconds.
REQUEST_TIMEOUT=300
MAX_RETRY=3
LOGIN_TIMEOUT=600
RESPONSE_STABLE_SECONDS=3

# Prompts longer than this many characters are attached as a file.
MAX_INLINE_CHARS=30000
# Attachments larger than this many bytes are rejected.
MAX_FILE_BYTES=20971520
